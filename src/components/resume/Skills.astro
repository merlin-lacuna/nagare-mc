---
// src/components/resume/Skills.astro
const groups = [
  {
    label: "Documentation",
    items: [
      "DITA",
      "DITA Open Toolkit",
      "reStructuredText",
      "Markdown",
      "MyST",
      "Good Docs Project",
      "Developing Quality Technical Information (Hargis et al.)",
    ],
  },
  {
    label: "Workflow",
    items: [
      "Docs-as-code",
      "Git",
      "GitHub / GitLab PR review",
      "Staging / production splits",
      "Continuous documentation",
      "Terminology management",
      "Content strategy",
    ],
  },
  {
    label: "Developer",
    items: [
      "Linux",
      "Command line",
      "Python (data cleaning, synthetic data, tutorial code)",
      "Apache Kafka",
      "Stream processing",
      "Cloud-native tooling",
    ],
  },
  {
    label: "Applied AI",
    items: [
      "Claude Code SDK (Klaus Kode)",
      "Model Context Protocol",
      "SLM fine-tuning for on-device inference",
      "LLM-as-a-Judge evaluation",
      "Synthetic data generation (gpt-oss-120b on Groq)",
      "RAG for technical documentation",
    ],
  },
];
---

<section class="resume-section scroll-reveal-animate">
  <h2>Tools &amp; Methodologies</h2>
  <div class="skills-list">
    {
      groups.map((group) => (
        <div class="skill-group">
          <h3>{group.label}</h3>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .resume-section {
    margin-bottom: 4rem;
  }
  h2 {
    font-size: clamp(1.4rem, 1.2rem + 1vw, 2rem);
    margin-bottom: 1.5rem;
    font-weight: 600;
    border-bottom: 1px solid var(--text-muted);
    padding-bottom: 0.5rem;
  }
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .skill-group h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--text-color);
    font-family: var(--font-family-sans);
  }
  .skill-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .skill-group li {
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }
</style>
