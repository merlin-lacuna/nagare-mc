---
// src/components/resume/Interests.astro
---

<section class="resume-section scroll-reveal-animate">
  <h2>Interests</h2>
  <p>Contemporary art and media art.</p>
  <ul>
    <li>Technical consulting for former art-school friends' projects.</li>
    <li>Regular at the Ars Electronica festival.</li>
  </ul>
  <p>Learning languages, swing dancing, Buddhism.</p>
</section>

<style>
  .resume-section {
    margin-bottom: 4rem;
  }
  .resume-section:last-child {
    margin-bottom: 0;
  }
  h2 {
    font-size: clamp(1.4rem, 1.2rem + 1vw, 2rem);
    margin-bottom: 1.5rem;
    font-weight: 600;
    border-bottom: 1px solid var(--text-muted);
    padding-bottom: 0.5rem;
  }
  p {
    font-family: var(--font-family-sans);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 0.6rem;
    color: var(--text-muted);
  }
  ul {
    list-style: disc;
    padding-left: 1.2rem;
    margin: 0 0 0.6rem;
    font-family: var(--font-family-sans);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  ul li {
    margin-bottom: 0.25rem;
  }
</style>
