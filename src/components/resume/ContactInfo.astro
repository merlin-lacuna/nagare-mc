---
// src/components/resume/ContactInfo.astro
import { Icon } from "astro-icon/components";
---

<section class="resume-section scroll-reveal-animate">
  <h2>Contact</h2>
  <ul class="contact-list">
    <li>
      <Icon name="ri:map-pin-line" class="contact-icon" />
      <span>Berlin &amp; Chiang Mai</span>
    </li>
    <li>
      <Icon name="ri:mail-line" class="contact-icon" />
      <a href="mailto:mcarter@gmail.com">mcarter@gmail.com</a>
    </li>
    <li>
      <Icon name="ri:linkedin-box-line" class="contact-icon" />
      <a
        href="https://linkedin.com/in/merlin-carter-bb303ab2"
        target="_blank"
        rel="noopener noreferrer">linkedin.com/in/merlin-carter</a
      >
    </li>
    <li>
      <Icon name="ri:github-line" class="contact-icon" />
      <a
        href="https://github.com/merlin-quix"
        target="_blank"
        rel="noopener noreferrer">github.com/merlin-quix</a
      >
    </li>
    <li>
      <Icon name="ri:github-line" class="contact-icon" />
      <a
        href="https://github.com/merlin-lacuna"
        target="_blank"
        rel="noopener noreferrer">github.com/merlin-lacuna</a
      >
    </li>
  </ul>
</section>

<style>
  .resume-section {
    margin-bottom: 4rem;
  }
  .resume-section:last-child {
    margin-bottom: 0;
  }
  h2 {
    font-size: clamp(1.4rem, 1.2rem + 1vw, 2rem);
    margin-bottom: 1.5rem;
    font-weight: 600;
    border-bottom: 1px solid var(--text-muted);
    padding-bottom: 0.5rem;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .contact-list li {
    margin-bottom: 0.7rem;
    display: flex;
    align-items: center;
  }
  .contact-icon {
    margin-right: 0.6em;
    font-size: 1.15em;
    flex-shrink: 0;
    opacity: 0.8;
  }
  .contact-list a {
    color: var(--link-color);
    text-decoration: none;
    word-break: break-all;
    transition: color 0.2s ease;
  }
  .contact-list a:hover {
    color: var(--link-hover-color);
    text-decoration: underline;
  }
</style>
