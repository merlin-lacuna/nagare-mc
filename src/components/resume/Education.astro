---
// src/components/resume/Education.astro
---

<section class="resume-section scroll-reveal-animate">
  <h2>Education</h2>

  <div class="education-entry">
    <div class="degree">Meisterschüler, Fine Art (sculpture)</div>
    <div class="institution">Universität der Künste Berlin</div>
    <div class="date">2009 – 2015</div>
  </div>

  <div class="education-entry">
    <div class="degree">B.Comm., Multimedia Publishing</div>
    <div class="institution">AUT University, Auckland</div>
    <div class="date">1995 – 1998</div>
  </div>
</section>

<style>
  .resume-section {
    margin-bottom: 4rem;
  }
  h2 {
    font-size: clamp(1.4rem, 1.2rem + 1vw, 2rem);
    margin-bottom: 1.5rem;
    font-weight: 600;
    border-bottom: 1px solid var(--text-muted);
    padding-bottom: 0.5rem;
  }
  .education-entry {
    margin-bottom: 1.25rem;
  }
  .education-entry:last-child {
    margin-bottom: 0;
  }
  .degree {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.15rem;
  }
  .institution {
    font-family: var(--font-family-sans);
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .date {
    font-family: var(--font-family-sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }
</style>
