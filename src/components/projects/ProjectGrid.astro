---
import { render, type CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  entries: CollectionEntry<"portfolio">[];
  emptyMessage?: string;
}

const { entries, emptyMessage = "Coming soon." } = Astro.props;

const sorted = [...entries].sort((a, b) => {
  const ad = a.data.date ? new Date(a.data.date).getTime() : -Infinity;
  const bd = b.data.date ? new Date(b.data.date).getTime() : -Infinity;
  return bd - ad;
});

const rendered = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

{
  rendered.length === 0 ? (
    <p class="empty-state">{emptyMessage}</p>
  ) : (
    <div class="projects-grid">
      {rendered.map(({ entry, Content }) => (
        <ProjectCard
          id={entry.id}
          title={entry.data.title}
          timeframe={entry.data.timeframe}
          imageSrc={entry.data.imageSrc}
          imageAlt={entry.data.imageAlt}
          githubUrl={entry.data.githubUrl}
          projectUrl={entry.data.projectUrl}
          techStack={entry.data.techStack}
        >
          <Content />
        </ProjectCard>
      ))}
    </div>
  )
}

<style>
  .empty-state {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 70ch;
  }

  .projects-grid {
    column-count: 1;
    column-gap: 3rem;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .projects-grid {
      column-count: 2;
      column-gap: 3rem;
      gap: 3rem;
    }
  }

  .projects-grid > :global(.project-card) {
    break-inside: avoid;
  }
</style>
