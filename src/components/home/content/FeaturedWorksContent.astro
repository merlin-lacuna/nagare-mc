---
import { getCollection } from "astro:content";
import FeaturedProjectCard from "../FeaturedProjectCard.astro";
import Button from "../../common/Button.astro";

const featuredProjects = await getCollection(
  "portfolio",
  (e) => e.data.isFeatured === true
);
const projectsUrl = "/portfolio";
---

<h2 slot="title" class="about-title scroll-target-title">Featured Works</h2>

<div class="about-content scroll-target-content featured-works-container">
  {
    featuredProjects.map((entry) => (
      <FeaturedProjectCard
        title={entry.data.title}
        homepageSummary={entry.data.homepageSummary}
        imageAlt={entry.data.imageAlt}
        githubUrl={entry.data.githubUrl}
        slug={entry.id}
      />
    ))
  }

  <div class="button-group">
    <Button
      class="button"
      href={projectsUrl}
      text="Discover More Projects"
      wrapperClass="projects-cta-button"
    />
  </div>
</div>

<style>
  .featured-works-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 696px) {
    .featured-works-container {
      width: 100%;
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .button-group {
    display: flex;
    gap: 1rem;
  }
</style>
