---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import Profile from "../components/resume/Profile.astro";
import Experience from "../components/resume/Experience.astro";
import SelectedWork from "../components/resume/SelectedWork.astro";
import OpenSourceContributions from "../components/resume/OpenSourceContributions.astro";
import Talks from "../components/resume/Talks.astro";
import Skills from "../components/resume/Skills.astro";
import Education from "../components/resume/Education.astro";
import Languages from "../components/resume/Languages.astro";
import ContactInfo from "../components/resume/ContactInfo.astro";
import Interests from "../components/resume/Interests.astro";
import Button from "../components/common/Button.astro";
---

<SubPageLayout title="Curriculum Vitae">
  <p class="role-tagline">
    Staff Technical Writer — Developer Content, Applied AI, Open-Source
    Documentation.
  </p>

  <Button
    href="/Merlin_Carter_CV.pdf"
    text="Download CV (PDF)"
    download="Merlin_Carter_CV.pdf"
    icon="↓"
    iconPosition="left"
    target="_blank"
    rel="noopener noreferrer"
    wrapperClass="resume-page-download"
  />

  <div class="resume-columns-wrapper">
    <div class="resume-main-column">
      <Profile />
      <Experience />
      <SelectedWork />
      <OpenSourceContributions />
      <Talks />
    </div>
    <div class="resume-sidebar">
      <Skills />
      <Education />
      <Languages />
      <ContactInfo />
      <Interests />
    </div>
  </div>
</SubPageLayout>

<style>
  .role-tagline {
    font-style: italic;
    font-size: 1.25rem;
    color: var(--text-muted);
    margin: 0 0 2rem;
    max-width: 80ch;
  }
  .resume-columns-wrapper {
    display: flex;
    flex-direction: row;
    gap: 5vw;
    margin-top: 2rem;
  }
  .resume-main-column {
    flex: 5;
    min-width: 0;
    font-size: 1.1rem;
  }
  .resume-sidebar {
    flex: 2;
    min-width: 0;
    font-size: 1.1rem;
  }
  @media (max-width: 900px) {
    .resume-columns-wrapper {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
